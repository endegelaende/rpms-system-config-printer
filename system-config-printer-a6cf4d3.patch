diff -up /dev/null system-config-printer-1.1.10/udev/udev-usb-printer.c
--- /dev/null	2009-07-31 14:10:14.275001833 +0100
+++ system-config-printer-1.1.10/udev/udev-usb-printer.c	2009-07-31 15:09:03.283086733 +0100
@@ -0,0 +1,454 @@
+/* -*- Mode: C; c-file-style: "gnu" -*-
+ * udev-usb-printer - a udev callout to configure print queues
+ * Copyright (C) 2009 Red Hat, Inc.
+ * Author: Tim Waugh <twaugh@redhat.com>
+ *
